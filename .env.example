# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env && chmod 600 .env
#
# Real environment variables always win over this file, so you can override any
# value with a shell export without editing here.
# Check what is loaded with: music-stack doctor   (prints presence, never values)

# -- Music.AI ---------------------------------------------------------------
# https://music.ai/  ->  developer dashboard
# Sent as `Authorization: <key>` -- the RAW key, with no "Bearer " prefix.
MUSIC_AI_API_KEY=

# -- Kits AI (Arpeggi Labs) -------------------------------------------------
# https://www.kits.ai/api
# Sent as `Authorization: Bearer <key>`.
KITS_API_KEY=

# Kits' alpha API allows roughly one job-creating POST per account per minute,
# and the client spaces requests to stay inside it. Set to 0 if your plan has
# no such limit.
# KITS_MIN_POST_INTERVAL=60

# -- Suno -------------------------------------------------------------------
# Deliberately inert until BOTH are set from the authenticated API reference at
# https://suno.com/platform. Do not paste a base URL guessed from a blog post
# or an unofficial wrapper -- see docs/security.md.
SUNO_API_KEY=
SUNO_API_BASE=

# -- Local behaviour --------------------------------------------------------
# How long to wait for a remote job before giving up. The job keeps running on
# the vendor's side; this is only client-side patience. Raise for long files.
# MUSIC_STACK_POLL_TIMEOUT=900

# Where project folders live. Defaults to ./projects inside the repo.
# MUSIC_STACK_PROJECTS_DIR=~/Music/music-stack-projects
